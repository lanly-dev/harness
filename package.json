{
  "name": "harness-client",
  "displayName": "Harness Client",
  "description": "VS Code extension for connecting to a local Harness instance (OpenAI-compatible, works offline).",
  "version": "0.1.0",

  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Harness",
      "properties": {
        "harness.url": {
          "type": "string",
          "default": "http://localhost:3080",
          "description": "URL of the local Harness server (OpenAI-compatible API endpoint)."
        },
        "harness.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "Default model to use when no model is selected."
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "harness",
        "displayName": "Harness (Local)",
        "id": "harness",
        "description": "Custom chat model provider for a local Harness instance.",
        "enabled": true
      }
    ],
    "commands": [
      {
        "command": "harness.configureProvider",
        "title": "Harness: Configure Provider URL",
        "category": "Harness"
      },
      {
        "command": "harness.configureApiKey",
        "title": "Harness: Configure API Key",
        "category": "Harness",
        "description": "API key configuration is not supported in this version."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.103.0",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}