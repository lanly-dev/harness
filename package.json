{
  "name": "harness-client",
  "displayName": "DeepSeek Harness",
  "description": "Use DeepSeek Harness from VS Code Chat through its managed SDK runtime.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "deepseekHarness.provider": {
          "type": "string",
          "default": "deepseek-official",
          "description": "DeepSeek Harness provider route."
        },
        "deepseekHarness.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "description": "Model ID used by DeepSeek Harness."
        },
        "deepseekHarness.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional Messages-compatible API base URL."
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "harness",
        "displayName": "DeepSeek Harness",
        "id": "harness",
        "description": "Chat through the DeepSeek Harness SDK runtime.",
        "enabled": true
      }
    ],
    "commands": [
      {
        "command": "harness.configureProvider",
        "title": "DeepSeek Harness: Configure Provider",
        "category": "Harness"
      },
      {
        "command": "harness.configureModel",
        "title": "DeepSeek Harness: Configure Model",
        "category": "Harness"
      },
      {
        "command": "harness.configureApiKey",
        "title": "DeepSeek Harness: Configure API Key",
        "category": "Harness",
        "description": "Store or clear the DeepSeek API key securely."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.103.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
